# Public (browser + SSR)
# Microsoft Clarity: Settings > Overview > Project ID. Empty disables tracking.
NUXT_PUBLIC_CLARITY_PROJECT_ID=z2fgjxhxv5
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the client
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The ONE account allowed into /admin. Server only.
NUXT_ADMIN_OWNER_EMAIL=you@example.com

# Confirmation mail for /volunteer (Brevo HTTP API). Leave empty to skip sending.
# Use the API key from Brevo → SMTP & API → API keys. Do NOT use SMTP host/port
# here — Cloudflare Workers cannot open SMTP sockets.
# NUXT_BREVO_API_KEY=xkeysib-xxxxxxxx
# NUXT_MAIL_FROM=Maker Faire Kochi <volunteer@makerfaire.in>
# NUXT_MAIL_REPLY_TO=you@your-inbox.com

# Optional override for OG / absolute URLs
# NUXT_PUBLIC_SITE_URL=https://makerfaire.in
